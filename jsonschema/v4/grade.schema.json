{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact"
        },
        "event_sequences": {
          "items": {
            "type": "integer"
          },
          "title": "Event Sequences",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cost": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost"
    },
    "evaluator_id": {
      "title": "Evaluator Id",
      "type": "string"
    },
    "evaluator_type": {
      "title": "Evaluator Type",
      "type": "string"
    },
    "evaluator_version": {
      "default": "builtin",
      "title": "Evaluator Version",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "reasoning": {
      "default": "",
      "title": "Reasoning",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "soft": {
      "default": false,
      "title": "Soft",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "error",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "tier": {
      "enum": [
        "static",
        "smoke",
        "outcome",
        "semantic",
        "situational",
        "end_to_end",
        "human"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "evaluator_id",
    "evaluator_type",
    "tier",
    "status"
  ],
  "title": "Grade",
  "type": "object"
}
